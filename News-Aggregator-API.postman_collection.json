        {
          "name": "Search News",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/news/search?query=bitcoin&lang=en",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "news",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "bitcoin"
                },
                {
                  "key": "lang",
                  "value": "en",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "relevancy",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                }
              ]
            },
            "description": "Search news by custom query using NewsCatcher CatchAll API (requires authentication)"
          },
          "response": [
            {
              "name": "Success - 200",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
