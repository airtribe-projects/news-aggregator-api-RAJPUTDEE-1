NODE_ENV=development
PORT=3000

JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# NewsCatcher CatchAll API Configuration
# Get your API key from: https://www.newscatcherapi.com/
NEWSCATCHER_API_KEY=your-newscatcher-api-key-here
NEWSCATCHER_BASE_URL=https://catchall.newscatcherapi.com

# CatchAll job polling settings
# Lower these for local learning/tests; keep higher values for real jobs
NEWSCATCHER_JOB_POLL_INTERVAL=30000
NEWSCATCHER_JOB_MAX_POLLS=30

LOG_LEVEL=debug
